# Godot 4 generated and imported files. Rebuilt by the editor on first open.
.godot/
*.translation
export_presets.cfg
export/
*.tmp

# Scratch directory the asset tools write generated textures into before
# embedding them in a GLB. Deliberately outside res://; regenerated on demand.
/build/

# Python bytecode from the asset pipeline in tools/ and the checks in tests/
__pycache__/
*.py[cod]
.venv/
venv/

# Astra editor session data and scratch captures. Screenshots worth keeping live
# in docs/images/, not here.
.astra/
.captures/

# Operating system and editor droppings
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/
